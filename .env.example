# Скопируй в .env; заполняй только нужные интеграции. .env НЕ коммитится.
# Сайт и каталог запускаются без ключей. Полное подтверждение корзины
# требует EKT_API_USER/EKT_API_PASSWORD для проверки живых остатков.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
MODEL_TIMEOUT_SECONDS=5.2
RESPONSE_TIMEOUT_SECONDS=7.2
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Необязательно: публичный URL этой основы, без завершающего слеша.
# Без него Telegram открывает свою корзину через t.me/<bot>?start=cart.
PUBLIC_BASE_URL=
# SQLite: data/catalog.sqlite, data/assistant.sqlite, data/cms.sqlite.
# В Docker этот каталог хранится в named volume, DATABASE_URL не используется.
# Порт/интерфейс на ПК для Docker Compose (порт контейнера всегда 8001).
EKT_HTTP_PORT=8001
EKT_BIND_HOST=127.0.0.1

EKT_API_BASE=https://ekt.kz/api
EKT_API_USER=
EKT_API_PASSWORD=

# CMS: без токена доступен только loopback самого процесса.
# Для CMS в Docker задай токен: запрос с ПК приходит через Docker gateway.
CMS_ADMIN_TOKEN=
# Необязательно: 1 включает фоновое обновление каталога раз в 300 секунд.
# Для обновления нужны EKT_API_USER и EKT_API_PASSWORD.
CATALOG_SYNC_ENABLED=0

# Только для диагностических scripts/check_nvidia.py и scripts/probe_fast_models.py.
# Веб-приложение использует OPENAI_API_KEY, эти значения в Compose не передаются.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
